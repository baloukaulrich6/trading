# Copie ce fichier en ".env" et remplis-le. Ne le partage JAMAIS (il contient tes mots de passe).

# TEST = aucun ordre envoyé ; ORDRES = ordres envoyés (sur un compte DÉMO d'abord)
MODE=TEST

# Sécurité : même en mode ORDRES, rien n'est envoyé sur un compte réel sans "oui" ici
COMPTE_REEL_CONFIRME=non

# Délai maximal de connexion à MT5 en millisecondes (60000 = 1 minute)
MT5_TIMEOUT_MS=60000

# Fenêtre des nouvelles entrées automatiques, heure de Douala.
HEURE_EXECUTION=09:00
HEURE_LIMITE=00:00

# Objectif facultatif de solde pour les entrées automatiques HFM réelles.
# Une date AAAA-MM-JJ inclut toute la journée en heure de Douala.
NKAP_OBJECTIF_USD=
NKAP_OBJECTIF_DATE_FIN=

# Notifications facultatives. Ne renseigne ces valeurs que dans .env.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Tableau Nkap accessible localement sur ce PC ou VPS.
PORT_INTERFACE=8765
NKAP_FANTOME=non
NKAP_CHOIX_MODE=non
HFM_DEMO_LOGIN=
HFM_DEMO_SERVEUR=
HFM_DEMO_MOT_DE_PASSE=
HFM_DEMO_CHEMIN=

# --- Exness ---
EXNESS_ACTIF=oui
EXNESS_LOGIN=
EXNESS_MOT_DE_PASSE=
EXNESS_SERVEUR=Exness-MT5Real9
EXNESS_CHEMIN=C:\MT5_Exness\terminal64.exe

# --- HFM (à activer quand le compte sera réactivé) ---
HFM_ACTIF=non
HFM_LOGIN=
HFM_MOT_DE_PASSE=
HFM_SERVEUR=
HFM_CHEMIN=C:\MT5_HFM\terminal64.exe
HFM_MARCHES=EURUSD,GBPUSD,USDJPY,XAUUSD,AUDUSD,USDCHF

# --- Claude ---
CLAUDE_ACTIF=oui
CLAUDE_MODELE=claude-haiku-5-5
ANTHROPIC_API_KEY=
